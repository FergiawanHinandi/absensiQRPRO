# =============================================================================
# AbsensiQRPro - Production Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to git!
# =============================================================================

# Application
APP_NAME=AbsensiQRPro
APP_ENV=production
APP_KEY=# AKAN DIGENERATE OTOMATIS
# QR_SECRET_KEY: WAJIB DIISI - kunci HMAC untuk signature QR absensi.
# HARUS BEDA dari APP_KEY, minimal 32 karakter, jangan pakai nilai default.
# Generate: openssl rand -base64 32
QR_SECRET_KEY=
APP_DEBUG=false
APP_URL=https://[DOMAIN_ANDA]
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Jakarta

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absensiqrpro
DB_USERNAME=absensi_user
DB_PASSWORD=# GANTI DENGAN PASSWORD PRODUCTION
DB_SSLMODE=require

# Read Replication (Optional)
DB_REPLICA_ENABLED=false
DB_READ_HOST=
DB_READ_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Redis Sentinel (High Availability)
REDIS_SENTINEL=false
REDIS_SENTINEL_HOSTS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
REDIS_SENTINEL_SERVICE=mymaster

# Cache
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_PREFIX=absensiqrpro_cache

# Session
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Broadcasting
BROADCAST_DRIVER=log

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@[DOMAIN_ANDA]"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (for S3 backup storage - Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend URL (for CORS)
FRONTEND_URL=https://[DOMAIN_ANDA]

# Sanctum
SANCTUM_STATEFUL_DOMAINS=[DOMAIN_ANDA]

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_QR_SCAN=30
RATE_LIMIT_EXPORT=10
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PASSWORD_RESET=3

# QR Code Settings
QR_EXPIRY_MINUTES=10
QR_SIGNATURE_EXPIRATION_SECONDS=10

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=# GANTI DENGAN MIDTRANS PRODUCTION KEY
MIDTRANS_CLIENT_KEY=# GANTI DENGAN MIDTRANS PRODUCTION KEY
MIDTRANS_MERCHANT_ID=# GANTI DENGAN MIDTRANS MERCHANT ID
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_WEBHOOK_URL=https://[DOMAIN_ANDA]/api/v1/webhooks/payment

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=# GANTI DENGAN FCM PRODUCTION KEY
FCM_SENDER_ID=# GANTI DENGAN FCM SENDER ID

# WhatsApp API (Optional)
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER=

# Sentry Error Tracking (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backup Configuration
BACKUP_ENCRYPTION_KEY=# GANTI DENGAN RANDOM 32 CHARACTER STRING
BACKUP_LOCAL_PATH=/backups/absensiqrpro
BACKUP_AWS_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-southeast-1

# Redis Sentinel for Queue
REDIS_SENTINEL_QUEUE=false
REDIS_SENTINEL_QUEUE_HOSTS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Alerts (Optional)
SLACK_SECURITY_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts

# Monitoring
MONITORING_ENABLED=true
SLOW_QUERY_THRESHOLD=1000
QUEUE_MONITORING_ENABLED=true

# Laravel Reverb (WebSocket)
REVERB_APP_KEY=
REVERB_APP_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=https

# Vite (Frontend Build)
VITE_API_URL=https://[DOMAIN_ANDA]/api/v1
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=[DOMAIN_ANDA]
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
VITE_MIDTRANS_CLIENT_KEY=${MIDTRANS_CLIENT_KEY}
VITE_APP_NAME=${APP_NAME}
