includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - routes
        - config
    
    # Levels: 0-9 (0 = basic, 9 = strictest)
    level: 5
    
    # Ignore patterns
    excludePaths:
        - bootstrap
        - storage
        - database/migrations
        - tests
    
    # Ignore specific errors (temporary - remove as we fix them)
    ignoreErrors:
        # Allow dynamic properties on Eloquent models
        - '#Access to an undefined property [a-zA-Z0-9\\_]+::\$[a-zA-Z_]+#'
        # Allow mixed return types from cache
        - '#Method [a-zA-Z\\]+::[a-zA-Z]+ has no return type specified#'
    
    # Report unmatched ignored errors
    reportUnmatchedIgnoredErrors: false

services:
    # Custom rules for tenant safety - prevents DB::table() usage on tenant models
    -
        class: PHPStan\Rules\TenantSafety\PreventRawQueryOnTenantModels
        tags:
            - phpstan.rules.rule
