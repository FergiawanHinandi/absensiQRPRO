# Production Environment Configuration
# Redis Sentinel for production environment
# IMPORTANT: Change all passwords before deploying to production

REDIS_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD
SENTINEL_QUORUM=2
SENTINEL_DOWN_AFTER_MS=5000
SENTINEL_FAILOVER_TIMEOUT_MS=30000
SENTINEL_PARALLEL_SYNCS=1
REDIS_MAXMEMORY=1024mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_LOG_LEVEL=warning
