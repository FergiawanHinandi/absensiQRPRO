# Redis Sentinel Configuration
# Copy this file to .env in the same directory and update with your values

# Redis Authentication
REDIS_PASSWORD=changeme_strong_password_here

# Sentinel Configuration
SENTINEL_QUORUM=2
SENTINEL_DOWN_AFTER_MS=5000
SENTINEL_FAILOVER_TIMEOUT_MS=30000
SENTINEL_PARALLEL_SYNCS=1

# Redis Memory Configuration
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Network Configuration
REDIS_MASTER_PORT=6379
REDIS_REPLICA_1_PORT=6380
REDIS_REPLICA_2_PORT=6381
SENTINEL_1_PORT=26379
SENTINEL_2_PORT=26380
SENTINEL_3_PORT=26381

# Persistence Configuration
REDIS_AOF_ENABLED=yes
REDIS_RDB_ENABLED=yes

# Logging
REDIS_LOG_LEVEL=notice
