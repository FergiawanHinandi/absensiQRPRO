APP_NAME="AbsensiQR API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Configuration (database already created)
# For PostgreSQL:
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=absensi_qr
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password

# Uncomment below untuk development dengan SQLite jika PostgreSQL belum install
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session
SESSION_TABLE=sessions
SESSION_PREFIX=session

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Maximum retry attempts for failed Redis connections
REDIS_MAX_RETRIES=3
# Health check interval in seconds
REDIS_HEALTH_CHECK_INTERVAL=30

# Redis Sentinel High Availability Configuration
# Set to true to enable Redis Sentinel mode
REDIS_SENTINELS=false
# Sentinel service name (must match sentinel.conf)
REDIS_SENTINEL_SERVICE=mymaster
# Individual sentinel endpoints (used when REDIS_SENTINELS=true)
REDIS_SENTINEL_1=tcp://sentinel-1:26379?timeout=0.1
REDIS_SENTINEL_2=tcp://sentinel-2:26379?timeout=0.1
REDIS_SENTINEL_3=tcp://sentinel-3:26379?timeout=0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Reverb WebSocket Configuration
REVERB_APP_ID=your_app_id_here
REVERB_APP_KEY=your_app_key_here
REVERB_APP_SECRET=your_app_secret_here
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# QR Code Configuration (CRITICAL SECURITY)
# Generate with: php artisan tinker --execute="echo base64_encode(random_bytes(32));"
# atau: openssl rand -base64 32  (minimal 32 karakter, HARUS beda dari APP_KEY)
QR_SECRET_KEY=
QR_EXPIRY_MINUTES=10
QR_MAX_AGE_HOURS=24

# Sentry Error Monitoring (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"

# Backup Security (CRITICAL)
# Generate a strong passphrase for AES-256 encryption
# Use: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
BACKUP_ENCRYPTION_KEY=change_this_to_a_very_secure_passphrase

# Backup Notifications
BACKUP_NOTIFICATION_EMAIL=admin@yourschool.com
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_SLACK_CHANNEL=#alerts

# Backup S3 Storage (Dedicated bucket for backups)
# Recommended: Use a separate AWS account/IAM user for backups
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-southeast-1
BACKUP_AWS_BUCKET=your-backup-bucket-name
BACKUP_AWS_ENDPOINT=

# Security Alert Notifications
# Telegram Bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SECURITY_CHAT_ID=your_chat_id_here

# Slack Webhook (create via Slack App Incoming Webhooks)
SLACK_SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Rate Limiting (Attempts / Time Window)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_QR_SCAN=30
RATE_LIMIT_EXPORT=10
RATE_LIMIT_PASSWORD_RESET=3

# QR Time Validation
# Tolerance time (in minutes) before and after schedule time
QR_TIME_TOLERANCE=15
# Enable strict time validation (true/false)
QR_STRICT_TIME=true
# Allow admin/principal to bypass time validation (true/false)
QR_ADMIN_BYPASS=true

# =================================================
# PRODUCTION MONITORING & OBSERVABILITY
# =================================================

# Enable/disable monitoring features
MONITORING_ENABLED=true

# Slow Query Detection (milliseconds)
SLOW_QUERY_WARNING_MS=500
SLOW_QUERY_CRITICAL_MS=2000
SLOW_QUERY_ALERT_THRESHOLD=10
LOG_ALL_QUERIES=false

# Queue Monitoring
QUEUE_MONITORING_ENABLED=true
QUEUE_BACKLOG_ALERT=1000
QUEUE_FAILED_ALERT=10
QUEUE_ALERT_COOLDOWN_MINUTES=5
QUEUE_ALERT_COOLDOWN_MAX_MINUTES=60

# Redis Monitoring
REDIS_MEMORY_WARNING_THRESHOLD=80
REDIS_MONITORING_ENABLED=true
REDIS_ALERT_COOLDOWN_MINUTES=60

# Error Rate Monitoring  
ERROR_RATE_ALERT=20

# System Resource Thresholds
MEMORY_WARNING_PERCENT=80
DISK_WARNING_PERCENT=85
RESPONSE_TIME_P95_THRESHOLD=500

# Alerting
ALERTS_ENABLED=true
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_EMAILS=
ALERT_RATE_LIMIT_MINUTES=60
MAINTENANCE_SUPPRESS_ALERTS=true

# Health Check
HEALTH_CHECK_CACHE_TTL=10

# Export Configuration
EXPORT_CHUNK_SIZE=1000
EXPORT_MEMORY_LIMIT=256
EXPORT_ENABLE_PROGRESS=true
EXPORT_TIMEOUT=600

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=production

# Query Profiling Configuration
QUERY_PROFILING_ENABLED=false
QUERY_SLOW_THRESHOLD=100
QUERY_LOG_EXECUTION_PLANS=true
QUERY_MAX_STORED=1000
QUERY_LOG_CHANNEL=daily
QUERY_STORE_IN_DB=true
QUERY_RETENTION_DAYS=30
QUERY_SAMPLE_RATE=1.0
QUERY_CRITICAL_THRESHOLD=1000
QUERY_WARNING_THRESHOLD=500
QUERY_ALERT_CHANNEL=slack
