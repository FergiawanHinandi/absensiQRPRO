# ==============================================
# AbsensiQRPro - Root .gitignore
# ==============================================

# ---- OS artifacts ----
.DS_Store
Thumbs.db
Desktop.ini
nul
*.swp
*.swo
*~

# ---- IDE / Editor ----
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- Claude / AI temp files ----
tmpclaude-*
claude_output*

# ---- AI-generated analysis docs (archived) ----
docs/_archive/

# ---- Node / JS ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- PHP / Composer ----
/vendor/

# ---- Environment files ----
.env
.env.*
!.env.example
!backend/.env.example
!frontend-web/.env.example
!AbsensiQRMobile/.env.example
!.env.production.template

# ---- Mobile Keystore ----
AbsensiQRMobile/keystore.properties
AbsensiQRMobile/*.jks
AbsensiQRMobile/*.keystore

# ---- Deployment reports ----
tests/load-test/results/
tests/security/reports/

# ---- Build outputs ----
dist/
dist-ssr/
build/
*.local

# ---- Logs ----
logs/
*.log

# ---- Backup & archive files ----
*.bak
*.php.bak
*.zip
*.tar.gz
*.rar

# ---- Test artifacts ----
coverage/
*.lcov
.phpunit.result.cache
.phpunit.cache/

# ---- Frontend legacy artifacts (never commit) ----
frontend-web/login_page.html
frontend-web/loginpage_tsx.txt
frontend-web/main_tsx.txt
frontend-web/vite_client.js
frontend-web/migrate-alerts.js
frontend-web/restart-clean.ps1

# ---- Env restore backups (never commit) ----
*.pre_restore_backup

# ---- Misc ----
*.key
*.pem
test-login.json
test_login.json

# ---- Secrets / Tokens (NEVER COMMIT) ----
tokens.json
**/tokens.json
*.token
*.secret
backend/tokens.local.json

# Environment Variables
.env
.env.*
!.env.example
!backend/.env.example
!frontend-web/.env.example
!AbsensiQRMobile/.env.example
!.env.production.template
backend/.env
frontend-web/.env

