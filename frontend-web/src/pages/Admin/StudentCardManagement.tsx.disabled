import React, { useState, useEffect } from 'react';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '../../components/ui/card';
import { Button } from '../../components/ui/Button';
import { Badge } from '../../components/ui/badge';
import { Alert, AlertDescription } from '../../components/ui/alert';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import {
  CreditCard,
  RefreshCw,
  XCircle,
  Eye,
  AlertTriangle,
  CheckCircle,
  Clock,
  User as UserIcon,
  Download,
  Calendar,
  CheckSquare,
  Printer
} from 'lucide-react';
import { useAuthStore } from '../../store/authStore';
import api from '../../lib/api';

interface Student {
  id: number;
  name: string;
  username: string; // NIS/NISN
  email: string;
  is_active: boolean;
  class_name?: string;
  photo_url?: string;
}

interface ClassModel {
  id: number;
  name: string;
}

interface StudentCardData {
  id: number;
  qr_hash: string;
  issued_at: string;
  distributed_at: string | null;
  revoked_at: string | null;
  is_active: boolean;
  revoked_reason?: string;
}

interface CardStatusResponse {
  has_active_card: boolean;
  status: 'active_distributed' | 'active_not_distributed' | 'no_card';
  card_id?: number;
  issued_at?: string;
  distributed_at?: string;
}

const StudentCardManagement: React.FC = () => {
  const { user } = useAuthStore();
  const [students, setStudents] = useState<Student[]>([]);
  const [classes, setClasses] = useState<ClassModel[]>([]);
  const [selectedClass, setSelectedClass] = useState<string>("all");
  const [selectedStudent, setSelectedStudent] = useState<Student | null>(null);

  const [cardStatus, setCardStatus] = useState<CardStatusResponse | null>(null);
  const [cardHistory, setCardHistory] = useState<StudentCardData[]>([]);

  const [loading, setLoading] = useState(false);
  const [actionLoading, setActionLoading] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);

  const isSchoolAdmin = user?.role_type === 'school_admin' || user?.role_type === 'admin';

  useEffect(() => {
    fetchClasses();
  }, []);

  useEffect(() => {
    fetchStudents();
  }, [selectedClass]);

  const fetchClasses = async () => {
    try {
      const response = await api.get('/api/v1/admin/classes');
      setClasses(response.data.data || []);
    } catch (err) {
      console.error('Failed to fetch classes', err);
    }
  };

  const fetchStudents = async () => {
    try {
      setLoading(true);
      let url = '/api/v1/admin/students';
      if (selectedClass && selectedClass !== "all") {
        url += `?class_id=${selectedClass}`;
      }
      const response = await api.get(url);
      setStudents(response.data.data || []);
    } catch (err: any) {
      setError('Gagal memuat data siswa');
    } finally {
      setLoading(false);
    }
  };

  const fetchCardDetails = async (studentId: number) => {
    try {
      // 1. Get Status
      const statusRes = await api.get(`/api/v1/admin/student-cards/${studentId}/status`);
      setCardStatus(statusRes.data.data);

      // 2. Get History
      const historyRes = await api.get(`/api/v1/admin/student-cards/${studentId}/history`);
      setCardHistory(historyRes.data.data || []);
    } catch (err: any) {
      setError('Gagal memuat data kartu siswa');
    }
  };

  const handleStudentSelect = (student: Student) => {
    setSelectedStudent(student);
    setCardStatus(null);
    setCardHistory([]);
    setError(null);
    setSuccess(null);
    fetchCardDetails(student.id);
  };

  const handleGenerateCard = async () => {
    if (!selectedStudent || !isSchoolAdmin) return;
    try {
      setActionLoading('generate');
      await api.post(`/api/v1/admin/student-cards/${selectedStudent.id}/generate`);
      setSuccess('Kartu QR berhasil dibuat');
      fetchCardDetails(selectedStudent.id);
    } catch (err: any) {
      setError(err.response?.data?.message || 'Gagal membuat kartu QR');
    } finally {
      setActionLoading(null);
    }
  };

  const handleRegenerateCard = async () => {
    if (!selectedStudent || !isSchoolAdmin) return;
    const reason = prompt("Masukkan alasan pembuatan ulang (misal: Hilang, Rusak):", "Hilang/Rusak");
    if (!reason) return;

    try {
      setActionLoading('regenerate');
      await api.post(`/api/v1/admin/student-cards/${selectedStudent.id}/regenerate`, { reason });
      setSuccess('Kartu QR berhasil dibuat ulang (kartu lama dinonaktifkan)');
      fetchCardDetails(selectedStudent.id);
    } catch (err: any) {
      setError(err.response?.data?.message || 'Gagal membuat ulang kartu QR');
    } finally {
      setActionLoading(null);
    }
  };

  const handleDeactivateCard = async () => {
    if (!selectedStudent || !isSchoolAdmin) return;
    const reason = prompt("Masukkan alasan penonaktifan:", "Dinonaktifkan oleh admin");
    if (!reason) return;

    if (!confirm('Apakah Anda yakin ingin menonaktifkan kartu ini? Siswa tidak akan bisa absen menggunakan kartu ini.')) return;

    try {
      setActionLoading('deactivate');
      await api.delete(`/api/v1/admin/student-cards/${selectedStudent.id}`, { data: { reason } });
      setSuccess('Kartu QR berhasil dinonaktifkan');
      fetchCardDetails(selectedStudent.id);
    } catch (err: any) {
      setError(err.response?.data?.message || 'Gagal menonaktifkan kartu QR');
    } finally {
      setActionLoading(null);
    }
  };

  const handleMarkDistributed = async () => {
    if (!cardStatus?.card_id || !isSchoolAdmin) return;
    try {
      setActionLoading('distribute');
      await api.post(`/api/v1/admin/student-cards/${cardStatus.card_id}/mark-distributed`);
      setSuccess('Kartu ditandai sebagai sudah didistribusikan');
      fetchCardDetails(selectedStudent!.id);
    } catch (err: any) {
      setError('Gagal menandai status distribusi');
    } finally {
      setActionLoading(null);
    }
  };

  const handleDownloadPdf = async () => {
    if (!selectedStudent) return;
    try {
      setActionLoading('download');
      const response = await api.post(`/api/v1/admin/students/${selectedStudent.id}/card-pdf`, {}, {
        responseType: 'blob'
      });

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `kartu-${selectedStudent.username}.pdf`);
      document.body.appendChild(link);
      link.click();
      link.remove();
    } catch (err) {
      setError('Gagal mengunduh PDF kartu');
    } finally {
      setActionLoading(null);
    }
  };

  const handleBulkPrintClass = async () => {
    if (!selectedClass || selectedClass === 'all') {
      alert("Pilih kelas terlebih dahulu untuk mencetak massal.");
      return;
    }

    try {
      setActionLoading('bulk-print');
      const response = await api.post(`/api/v1/admin/classes/${selectedClass}/card-pdf-bulk`, {}, {
        responseType: 'blob'
      });

      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `kartu-kelas-${selectedClass}.zip`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      setSuccess("File ZIP sedang diunduh.");
    } catch (err) {
      setError('Gagal generate bulk PDF.');
    } finally {
      setActionLoading(null);
    }
  };

  if (!isSchoolAdmin) {
    return (
      <div className="p-6">
        <Alert variant="destructive">
          <AlertTriangle className="h-4 w-4" />
          <AlertDescription>Hanya Admin Sekolah yang dapat mengakses halaman ini.</AlertDescription>
        </Alert>
      </div>
    );
  }

  return (
    <div className="p-6 space-y-6">
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold">Manajemen Kartu Siswa</h1>
          <p className="text-gray-500">Generate, cetak, dan kelola status kartu identitas QR siswa</p>
        </div>

        {/* Bulk Action - Only show if a specific class is selected */}
        {selectedClass !== "all" && (
          <Button variant="secondary" onClick={handleBulkPrintClass} disabled={actionLoading === 'bulk-print'}>
            {actionLoading === 'bulk-print' ? <RefreshCw className="h-4 w-4 mr-2 animate-spin" /> : <Printer className="h-4 w-4 mr-2" />}
            Cetak Massal Kelas (ZIP)
          </Button>
        )}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left Column: Student List & Filtering */}
        <Card className="lg:col-span-4 h-[calc(100vh-12rem)] flex flex-col">
          <CardHeader className="pb-3">
            <CardTitle className="text-lg">Daftar Siswa</CardTitle>
            <div className="pt-2">
              <Select value={selectedClass} onValueChange={setSelectedClass}>
                <SelectTrigger>
                  <SelectValue placeholder="Pilih Kelas" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">Semua Kelas</SelectItem>
                  {classes.map((cls) => (
                    <SelectItem key={cls.id} value={String(cls.id)}>{cls.name}</SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>
          </CardHeader>
          <CardContent className="flex-1 overflow-y-auto pt-0">
            {loading ? (
              <div className="flex justify-center py-8"><RefreshCw className="h-6 w-6 animate-spin text-gray-400" /></div>
            ) : (
              <div className="space-y-2">
                {students.map((student) => (
                  <div
                    key={student.id}
                    onClick={() => handleStudentSelect(student)}
                    className={`p-3 rounded-md cursor-pointer border transition-colors ${selectedStudent?.id === student.id ? 'bg-blue-50 border-blue-200' : 'hover:bg-gray-50 border-transparent'
                      }`}
                  >
                    <div className="font-medium text-gray-900">{student.name}</div>
                    <div className="text-xs text-gray-500 flex justify-between">
                      <span>{student.username}</span>
                      <span>{student.class_name}</span>
                    </div>
                  </div>
                ))}
                {students.length === 0 && <div className="text-center text-gray-500 py-4">Tidak ada siswa ditemukan.</div>}
              </div>
            )}
          </CardContent>
        </Card>

        {/* Right Column: Card Details & Actions */}
        <div className="lg:col-span-8 space-y-6">
          {error && <Alert variant="destructive"><AlertDescription>{error}</AlertDescription></Alert>}
          {success && <Alert className="bg-green-50 border-green-200"><CheckCircle className="h-4 w-4 text-green-600" /><AlertDescription className="text-green-700 ml-2">{success}</AlertDescription></Alert>}

          {!selectedStudent ? (
            <div className="flex h-64 items-center justify-center border-2 border-dashed border-gray-200 rounded-lg text-gray-400">
              Pilih siswa dari daftar di sebelah kiri
            </div>
          ) : (
            <>
              {/* Active Card Status */}
              <Card>
                <CardHeader>
                  <CardTitle className="flex justify-between items-center">
                    <span>Status Kartu Aktif</span>
                    {cardStatus?.has_active_card ? (
                      <Badge className="bg-green-500">Aktif</Badge>
                    ) : (
                      <Badge variant="secondary">Tidak Ada Kartu</Badge>
                    )}
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-6">
                  <div className="flex items-start gap-4">
                    {/* Photo Preview */}
                    <div className="w-24 h-32 bg-gray-100 rounded-md border flex items-center justify-center overflow-hidden">
                      {selectedStudent.photo_url ? (
                        <img src={selectedStudent.photo_url} alt={selectedStudent.name} className="w-full h-full object-cover" />
                      ) : (
                        <UserIcon className="h-10 w-10 text-gray-300" />
                      )}
                    </div>

                    <div className="flex-1 space-y-2">
                      <h3 className="text-xl font-bold">{selectedStudent.name}</h3>
                      <p className="text-gray-500">NIS/NISN: {selectedStudent.username}</p>

                      {cardStatus?.has_active_card && (
                        <div className="mt-4 grid grid-cols-2 gap-4 text-sm">
                          <div>
                            <span className="text-gray-500 block">Tanggal Dibuat</span>
                            <span className="font-medium">{new Date(cardStatus.issued_at!).toLocaleDateString('id-ID')}</span>
                          </div>
                          <div>
                            <span className="text-gray-500 block">Status Distribusi</span>
                            {cardStatus.distributed_at ? (
                              <span className="text-green-600 flex items-center gap-1"><CheckCircle className="h-3 w-3" /> Didistribusikan</span>
                            ) : (
                              <span className="text-orange-500 flex items-center gap-1"><Clock className="h-3 w-3" /> Belum Didistribusikan</span>
                            )}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>

                  <hr className="border-gray-100" />

                  {/* Actions */}
                  <div className="flex flex-wrap gap-3">
                    {!cardStatus?.has_active_card ? (
                      <Button onClick={handleGenerateCard} disabled={!!actionLoading}>
                        {actionLoading === 'generate' && <RefreshCw className="mr-2 h-4 w-4 animate-spin" />}
                        Buat Kartu Baru
                      </Button>
                    ) : (
                      <>
                        <Button variant="secondary" onClick={handleDownloadPdf} disabled={!!actionLoading}>
                          <Download className="mr-2 h-4 w-4" />
                          Download PDF
                        </Button>

                        {!cardStatus.distributed_at && (
                          <Button variant="secondary" className="border-orange-200 hover:bg-orange-50 text-orange-700" onClick={handleMarkDistributed} disabled={!!actionLoading}>
                            <CheckSquare className="mr-2 h-4 w-4" />
                            Tandai Sudah Diterima
                          </Button>
                        )}

                        <Button variant="secondary" onClick={handleRegenerateCard} disabled={!!actionLoading}>
                          <RefreshCw className="mr-2 h-4 w-4" />
                          Regenerate (Hilang/Rusak)
                        </Button>

                        <Button variant="danger" onClick={handleDeactivateCard} disabled={!!actionLoading}>
                          <XCircle className="mr-2 h-4 w-4" />
                          Nonaktifkan
                        </Button>
                      </>
                    )}
                  </div>
                </CardContent>
              </Card>

              {/* History */}
              <Card>
                <CardHeader><CardTitle className="text-base">Riwayat Kartu</CardTitle></CardHeader>
                <CardContent>
                  {cardHistory.length === 0 ? (
                    <p className="text-gray-500 text-sm">Belum ada riwayat kartu.</p>
                  ) : (
                    <div className="space-y-3">
                      {cardHistory.map((card) => (
                        <div key={card.id} className="flex justify-between items-start text-sm p-3 bg-gray-50 rounded-lg border border-gray-100">
                          <div>
                            <div className="font-medium flex items-center gap-2">
                              Kartu #{card.id}
                              {card.is_active ? <Badge className="h-5" variant="default">Aktif</Badge> : <Badge className="h-5 text-gray-500" variant="outline">Nonaktif</Badge>}
                            </div>
                            <div className="text-gray-500 mt-1">
                              Dibuat: {new Date(card.issued_at).toLocaleDateString()}
                            </div>
                            {card.revoked_at && (
                              <div className="text-red-500 mt-1 flex items-center gap-1">
                                <XCircle className="h-3 w-3" />
                                Nonaktif: {new Date(card.revoked_at).toLocaleDateString()} ({card.revoked_reason})
                              </div>
                            )}
                          </div>
                          <div className="text-right">
                            {card.distributed_at ? (
                              <Badge variant="outline" className="text-green-600 bg-green-50 border-green-200">Terdistribusi</Badge>
                            ) : (
                              <Badge variant="outline" className="text-orange-600 bg-orange-50 border-orange-200">Belum Distribusi</Badge>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </CardContent>
              </Card>
            </>
          )}
        </div>
      </div>
    </div>
  );
};