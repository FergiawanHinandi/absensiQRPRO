# ==============================================================================
# AbsensiQRPro - Monitoring Stack Configuration (.env)
# ==============================================================================
# Copy this file to .env in the project root before running:
#   cp infrastructure/monitoring.env.example .env
#   docker-compose -f docker-compose.observability.yml up -d
# ==============================================================================

# --- Grafana ---
# Admin password for Grafana web UI (default: admin)
GF_ADMIN_PASSWORD=admin

# --- PostgreSQL Exporter ---
# Database DSN for Prometheus PostgreSQL exporter
PG_EXPORTER_DSN=postgresql://absensi:password@postgres:5432/absensi?sslmode=disable

# --- Redis Exporter ---
# Redis address for Prometheus Redis exporter
REDIS_ADDR=redis:6379
