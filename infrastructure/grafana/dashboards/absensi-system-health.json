{
  "__inputs": [],
  "__requires": [],
  "title": "AbsensiQR Pro - System Health & Attendance KPIs",
  "uid": "absensi-system-health",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["absensi", "production", "system-health"],
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(absensi_http_requests_total[5m]))",
          "legendFormat": "Requests/s"
        }
      ],
      "description": "API request rate per second (5min average)"
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "absensi_http_error_rate_percent",
          "legendFormat": "Error %"
        }
      ],
      "description": "HTTP error rate percentage"
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(absensi_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "description": "95th percentile API latency in seconds"
    },
    {
      "title": "Database Query Duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "absensi_db_query_duration_seconds_avg",
          "legendFormat": "Avg"
        },
        {
          "expr": "absensi_db_query_duration_seconds_max",
          "legendFormat": "Max"
        }
      ],
      "description": "Database query duration (avg and max)"
    },
    {
      "title": "Database Connection Pool",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "absensi_db_connections_usage_percent"
        }
      ],
      "description": "Database connection pool usage %"
    },
    {
      "title": "Slow Queries",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 4, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(absensi_db_slow_queries_total[5m])",
          "legendFormat": "Slow queries/s"
        }
      ],
      "description": "Slow queries per second (>300ms)"
    },
    {
      "title": "Redis Memory Usage",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "absensi_redis_memory_usage_percent"
        }
      ],
      "description": "Redis memory usage %"
    },
    {
      "title": "Redis Cache Hit Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "absensi_redis_hit_rate_percent",
          "legendFormat": "Hit rate"
        }
      ],
      "description": "Redis cache hit rate %"
    },
    {
      "title": "Redis Connected Clients",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "targets": [
        {
          "expr": "absensi_redis_connected_clients",
          "legendFormat": "Clients"
        }
      ],
      "description": "Connected Redis clients"
    },
    {
      "title": "Redis Keys Total",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "targets": [
        {
          "expr": "absensi_redis_keys_total",
          "legendFormat": "Keys"
        }
      ],
      "description": "Total Redis keys"
    },
    {
      "title": "Queue Pending Jobs",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "absensi_queue_jobs_pending_total",
          "legendFormat": "Pending"
        }
      ],
      "description": "Pending jobs in queue"
    },
    {
      "title": "Failed Jobs (Last Hour)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 4, "x": 8, "y": 24},
      "targets": [
        {
          "expr": "absensi_queue_jobs_failed_last_hour"
        }
      ],
      "description": "Failed jobs in last hour"
    },
    {
      "title": "Job Duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 4, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "absensi_queue_job_duration_seconds_avg",
          "legendFormat": "Avg"
        },
        {
          "expr": "absensi_queue_job_duration_seconds_max",
          "legendFormat": "Max"
        }
      ]
    },
    {
      "title": "Jobs Processed Total",
      "type": "stat",
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 24},
      "targets": [
        {
          "expr": "absensi_queue_jobs_processed_total"
        }
      ],
      "description": "Total jobs processed"
    },
    {
      "title": "Attendance Scans Today",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "absensi_attendance_scans_today"
        }
      ],
      "description": "Total attendance scans today"
    },
    {
      "title": "Attendance by Status",
      "type": "piechart",
      "gridPos": {"h": 6, "w": 8, "x": 4, "y": 32},
      "targets": [
        {
          "expr": "absensi_attendance_by_status",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Today's attendance break down by status"
    },
    {
      "title": "Scan Rate (per minute)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 32},
      "targets": [
        {
          "expr": "absensi_attendance_scan_rate",
          "legendFormat": "Scans/min"
        }
      ],
      "description": "Attendance scan rate (5min avg)"
    },
    {
      "title": "Active Schools",
      "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 18, "y": 32},
      "targets": [
        {
          "expr": "absensi_schools_active"
        }
      ],
      "description": "Total active schools"
    },
    {
      "title": "Deadlock Retries",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 38},
      "targets": [
        {
          "expr": "rate(absensi_deadlock_retries_total[5m])",
          "legendFormat": "Retries/s"
        },
        {
          "expr": "rate(absensi_deadlock_retries_successful[5m])",
          "legendFormat": "Successful/s"
        },
        {
          "expr": "rate(absensi_deadlock_retries_exhausted[5m])",
          "legendFormat": "Exhausted/s"
        }
      ],
      "description": "Deadlock retry rate per second"
    },
    {
      "title": "Deadlock Retry Success Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 8, "y": 38},
      "targets": [
        {
          "expr": "absensi_deadlock_retry_success_rate_percent"
        }
      ]
    },
    {
      "title": "PHP Memory Usage",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 12, "y": 38},
      "targets": [
        {
          "expr": "absensi_php_memory_usage_bytes",
          "legendFormat": "Used"
        }
      ],
      "description": "PHP memory usage"
    },
    {
      "title": "Opcache Hit Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 38},
      "targets": [
        {
          "expr": "absensi_opcache_hit_rate_percent"
        }
      ]
    },
    {
      "title": "Service Status",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 46},
      "collapsed": false
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "constant",
        "label": "Environment",
        "query": "production",
        "current": {"text": "production", "value": "production"}
      }
    ]
  }
}
