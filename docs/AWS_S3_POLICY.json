{
    "Version": "2012-10-17",
    "Id": "AbsensiBackupBucketPolicy",
    "Statement": [
        {
            "Sid": "DenyAllExceptAppIP",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::absensi-backups-secure",
                "arn:aws:s3:::absensi-backups-secure/*"
            ],
            "Condition": {
                "NotIpAddress": {
                    "aws:SourceIp": "203.0.113.50/32"
                },
                "StringNotEquals": {
                    "aws:PrincipalAccount": "${AWS::AccountId}"
                }
            }
        },
        {
            "Sid": "AllowAppIPFullAccess",
            "Effect": "Allow",
            "Principal": "*",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::absensi-backups-secure",
                "arn:aws:s3:::absensi-backups-secure/*"
            ],
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": "203.0.113.50/32"
                }
            }
        },
        {
            "Sid": "DenyInsecureTransport",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::absensi-backups-secure",
                "arn:aws:s3:::absensi-backups-secure/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        },
        {
            "Sid": "DenyUnencryptedObjectUploads",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::absensi-backups-secure/*",
            "Condition": {
                "StringNotEquals": {
                    "s3:x-amz-server-side-encryption": "AES256"
                }
            }
        }
    ]
}