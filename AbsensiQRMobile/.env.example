# API Configuration
# IMPORTANT: Replace with your actual API URL
# Production API URL
EXPO_PUBLIC_API_URL=https://api.absensi.example.com/api/v1

# React Native Config variables (used by react-native-config)
API_BASE_URL=https://api.absensi.example.com/api/v1
API_HOSTNAME=api.absensi.example.com

# Development URLs (uncomment as needed):
# For Android Emulator: API_BASE_URL=http://10.0.2.2:8000/api/v1
# For iOS Simulator: API_BASE_URL=http://localhost:8000/api/v1
# For Physical Device: API_BASE_URL=http://YOUR_COMPUTER_IP:8000/api/v1

# API Timeout (in milliseconds)
API_TIMEOUT=30000

# ============================================================
# SSL CERTIFICATE PINNING CONFIGURATION
# ============================================================
# Enable SSL pinning (set to 'true' for production)
ENABLE_SSL_PINNING=false

# SSL Certificate Public Key Hashes (SHA256, Base64 encoded)
# 
# How to extract your certificate hash:
# openssl s_client -connect YOUR_DOMAIN:443 -servername YOUR_DOMAIN 2>/dev/null | \
#   openssl x509 -pubkey -noout | \
#   openssl pkey -pubin -outform der | \
#   openssl dgst -sha256 -binary | \
#   openssl enc -base64
#
# Primary certificate hash
SSL_PIN_HASH_PRIMARY=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Backup certificate hash (for certificate rotation)
SSL_PIN_HASH_BACKUP=sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# ============================================================

# App Configuration
APP_NAME=AbsensiQR Pro
APP_VERSION=1.0.0

# Feature Flags (Optional)
ENABLE_DEV_TOOLS=false
ENABLE_LOGS=false
